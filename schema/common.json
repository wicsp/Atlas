{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schema/common.json",
  "title": "Common",
  "$defs": {
    "Id": {
      "description": "<前缀>_<ULID>，例如 pap_01J9Z3...。前缀见 IdPrefix。",
      "type": "string",
      "pattern": "^(pap|idea|prj|task|exp|rpt|job)_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Timestamp": { "type": "string", "format": "date-time" },
    "Base": {
      "type": "object",
      "required": ["id", "type", "title", "created", "updated"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/Id" },
        "type": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "created": { "$ref": "#/$defs/Timestamp" },
        "updated": { "$ref": "#/$defs/Timestamp" },
        "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
        "related": {
          "description": "显式关联；正文里的 [[id]] 链接由 indexer 另行解析",
          "type": "array", "items": { "$ref": "#/$defs/Id" }, "default": []
        }
      }
    },
    "Assignee": {
      "description": "human 表示自己；agent 表示派给某个 AI",
      "oneOf": [
        { "const": "human" },
        {
          "type": "object", "required": ["agent"],
          "properties": {
            "agent": { "enum": ["claude-code", "codex", "pi"] },
            "device": { "type": "string", "description": "指定设备；省略则由调度决定" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
