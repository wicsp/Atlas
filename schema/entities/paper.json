{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.local/schema/entities/paper.json",
  "title": "Paper",
  "description": "论文笔记。文件位于 vault/papers/<citekey>.md，如 He_2020_LightGCN.md（见 ADR 0004）",
  "allOf": [{ "$ref": "../common.json#/$defs/Base" }],
  "type": "object",
  "required": ["type", "citekey", "authors", "year"],
  "properties": {
    "type": { "const": "paper" },
    "citekey": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z]*_[0-9]{4}_[A-Za-z0-9]+$",
      "description": "第一作者姓_年份_标题缩写，如 He_2020_LightGCN；同时是文件名和 refs.bib 的 key。规则见 ADR 0004"
    },
    "authors": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "year": { "type": "integer" },
    "venue": { "type": "string" },
    "arxiv": { "type": "string" },
    "doi": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "status": { "enum": ["to-read", "reading", "read"], "default": "to-read" }
  }
}
