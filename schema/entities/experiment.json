{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.local/schema/entities/experiment.json",
  "title": "Experiment",
  "allOf": [{ "$ref": "../common.json#/$defs/Base" }],
  "type": "object",
  "required": ["type", "project"],
  "properties": {
    "type": { "const": "experiment" },
    "project": { "$ref": "../common.json#/$defs/Id" },
    "status": { "enum": ["planned", "running", "done", "failed"], "default": "planned" },
    "hypothesis": { "type": "string" },
    "config_ref": { "type": "string", "description": "配置文件路径或 git commit" },
    "device": { "type": "string" },
    "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
    "artifacts": { "type": "array", "items": { "type": "string" } }
  }
}
