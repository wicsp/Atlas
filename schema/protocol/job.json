{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schema/protocol/job.json",
  "title": "Job",
  "description": "Hub ↔ Runtime 的工作单元。Runtime 按 capabilities 领取，执行后回报结果。",
  "type": "object",
  "required": ["protocol_version", "id", "kind", "requires", "input", "status", "created"],
  "properties": {
    "protocol_version": { "const": 1 },
    "id": { "$ref": "../common.json#/$defs/Id" },
    "kind": {
      "enum": ["agent.run", "script.run", "paper.ingest"],
      "description": "agent.run：调用 coding agent；script.run：跑脚本/实验；paper.ingest：论文入库"
    },
    "requires": {
      "description": "Runtime 必须具备的能力，如 [\"agent:claude-code\", \"gpu\"]",
      "type": "array", "items": { "type": "string" }
    },
    "input": { "type": "object", "description": "按 kind 解释；agent.run 至少含 prompt 与 workspace" },
    "status": { "enum": ["queued", "claimed", "running", "succeeded", "failed", "cancelled"] },
    "claimed_by": { "type": "string", "description": "Runtime 的设备 ID" },
    "result_ref": { "type": "string", "description": "结果位置：vault 中的路径、git 分支或 PR" },
    "error": { "type": "string" },
    "source": { "$ref": "../common.json#/$defs/Id", "description": "触发它的 task，可空" },
    "created": { "$ref": "../common.json#/$defs/Timestamp" },
    "started": { "$ref": "../common.json#/$defs/Timestamp" },
    "finished": { "$ref": "../common.json#/$defs/Timestamp" }
  },
  "additionalProperties": false
}
